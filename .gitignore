# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/

# Supabase local
supabase/.branches/
supabase/.temp/

# Vercel
.vercel/

# Documentos de trabajo temporales
*.tmp
*.tmp.md
*.mdtmp

# Informes de validacion: son de trabajo, no del proyecto.
# Se conservan en `docs/legacy/` cuando forman parte del historial.
validacion-*.md

# Referencias: codigo de terceros clonado solo para leer.
# Se versiona el contenido (es el objeto del analisis) pero no su historial.
referencias/**/.git/
referencias/**/node_modules/
referencias/**/data/

# Entorno: nunca se versiona un secreto
.env
.env.*
!.env.example

# Sistema y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Documentacion GENERADA (la fuente .md dentro de docs/ SI se versiona).
# Se ignoran unicamente los artefactos que produce el generador.
docs/_build/
docs/_site/
docs/site/
