    "schemas": {
      "CambioContrasenaResource": {
        "description": "Confirmacion del cambio de credencial.\n\nLa contrasena **no viaja**: la credencial vive en Supabase Auth y el\nbackend ni la ve ni la verifica. Lo que sale es que la bandera\n`debe_cambiar_contrasena` quedo limpia.",
        "properties": {
          "confirmado": {
            "title": "Confirmado",
            "type": "boolean"
          },
          "usuario_id": {
            "description": "Usuario cuya credencial quedo confirmada",
            "format": "uuid",
            "title": "Usuario Id",
            "type": "string"
          }
        },
        "required": [
          "usuario_id",
          "confirmado"
        ],
        "title": "CambioContrasenaResource",
        "type": "object"
      },
      "CierreSesionResource": {
