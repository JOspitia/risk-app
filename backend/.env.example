# Contrato entre la maquina y el proyecto (seccion 8 de docs/ARQUITECTURA.md).
#
# Si una variable no esta aqui, no existe. Copia este archivo a `.env` y
# rellena los valores. El `.env` nunca se versiona.
#
#   cp .env.example .env

# --- Supabase ---------------------------------------------------------------

# URL del proyecto. Tambien define el emisor del JWT: {SUPABASE_URL}/auth/v1
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave publica. La usa el frontend; nunca la llave de servicio.
SUPABASE_ANON_KEY=tu-llave-publica

# Llave de servicio. Solo backend. El unico adaptador autorizado a usarla es
# `adapters/supabase/admin.py`, para administrar usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-de-servicio

# Solo para proyectos con claves simetricas (HS256). Los proyectos nuevos usan
# JWKS y esta variable se deja vacia.
SUPABASE_JWT_SECRET=

# Claves publicas para validar tokens asimetricos (RS256/ES256).
# Si se deja vacia, se deriva de SUPABASE_URL.
SUPABASE_JWKS_URL=

# --- Otros ------------------------------------------------------------------

# Solo para el script de validacion de migraciones en desarrollo.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Limite de tamano del archivo. En la v1 aplica a partir del modo servidor.
MAX_UPLOAD_MB=50

# Origenes permitidos, separados por comas. Nunca `*` con credenciales.
CORS_ORIGINS=http://localhost:5173

# Nivel de log. No se registra nunca el texto del documento.
LOG_LEVEL=INFO
