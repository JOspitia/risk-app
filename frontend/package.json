{
  "name": "risk-app-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "api:types": "openapi-typescript ../backend/tests/contract/openapi.json -o src/api/types.ts",
    "postinstall": "echo 'Ver README.md: openapi-typescript declara peer typescript ^5.x y el proyecto usa 6.0.3'"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.89",
    "@supabase/supabase-js": "2.119.2",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.5.438",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.11",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.16.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14"
  }
}
