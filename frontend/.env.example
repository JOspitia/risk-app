# Contrato entre la maquina y el frontend (seccion 8 de docs/ARQUITECTURA.md).
#
# Copia este archivo a `.env` y rellena los valores. Las variables `VITE_` se
# exponen en el bundle del navegador: aqui solo van llaves publicas.
#
#   cp .env.example .env

# La misma URL del backend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# La llave publica. NUNCA la `service_role`: en el navegador es publica.
VITE_SUPABASE_ANON_KEY=tu-llave-publica

# Donde vive la API.
VITE_API_BASE_URL=http://localhost:8000
