# Contrato entre la maquina y el frontend (seccion 8 de docs/ARQUITECTURA.md).
#
# Copia este archivo a `.env` y rellena los valores. Las variables `VITE_` se
# exponen en el bundle del navegador: aqui solo van llaves publicas.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------
# EL PREFIJO ES `VITE_`, NO `NEXT_PUBLIC_`
#
# El prefijo lo elige el bundler, no Supabase. Este proyecto usa Vite, asi que
# Vite solo expone las variables que empiezan por `VITE_`. Un `NEXT_PUBLIC_` en
# este archivo no se leeria nunca: la variable llegaria al navegador como
# `undefined`, y el fallo aparece en el navegador, no al arrancar.
# -----------------------------------------------------------------------------

# La misma URL del backend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# La llave publica. NUNCA la `service_role`: en el navegador es publica.
#
# Supabase la llama "publishable key" (`sb_publishable_...`). Antes se llamaba
# "anon key", y el nombre viejo sigue en la documentacion de la plataforma. El
# valor es el mismo: la llave que el RLS deja pasar, y nada mas.
VITE_SUPABASE_PUBLISHABLE_KEY=tu-llave-publica

# Donde vive la API.
VITE_API_BASE_URL=http://localhost:8000
